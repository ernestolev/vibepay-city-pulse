# Copy this file to .env.local (gitignored). Never commit real keys.
# After editing: stop and restart `npm run dev` (Vite only reads env at startup).

# Supabase Dashboard → tu proyecto → Project Settings → API
# 1) Project URL → debe ser https://xxxx.supabase.co (no la URL del dashboard)
# 2) anon public key → la clave "public" / anon (no uses service_role en el front)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Si falla el upsert con PGRST204 / flash_offers: en SQL Editor ejecuta las
# migraciones de supabase/migrations (incl. 20260128120000_merchant_flash_offers_json.sql).

# Optional (existing)
# VITE_TAVILY_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
