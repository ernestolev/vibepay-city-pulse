# Copy to .env.local (gitignored) for local dev. Never commit real keys.

# Get these from: Supabase Dashboard → Project Settings → API
# — Project URL (not the dashboard URL) → https://xxxx.supabase.co
# — anon public key (safe for the browser, protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional (existing)
# VITE_TAVILY_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=
